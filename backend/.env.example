DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/recruitify
SECRET_KEY=replace-with-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Neutral employer name shown in generated demo contract PDFs
CONTRACT_COMPANY_NAME=Recruitify

# Gmail SMTP notifications. Use a Gmail App Password, never your normal Gmail password.
SMTP_EMAIL=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-gmail-app-password

# Comma-separated frontend origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://recruitify-nu.vercel.app
